# Build output. The project is normally configured out of source
# (`cmake -S . -B build`), but in-source configuration leaves its droppings
# here too, so both are covered.
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
install_manifest.txt
Makefile
.qt/
.cache/

# Qt's generated moc/rcc/uic output.
*_autogen/

# CTest.
CTestTestfile.cmake
DartConfiguration.tcl
Testing/

# Built binaries.
#
# Anchored to the repository root and spelled out. This used to be `ratty*`,
# which matches any path *component* starting with "ratty" -- and so silently
# excluded `resources/themes/ratty-dark.yaml`, the default theme, from version
# control. A fresh clone could not build, because themes.qrc references a file
# that was never committed.
/ratty
/tests/test_config
/tests/test_input
/tests/test_mouse
/tests/test_render
/tests/test_scroll_gl
/tests/test_splits
/tests/test_splits_gl
/tests/test_tabbar
/tests/test_terminal

# Compiled object and library files.
*.o
*.obj
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll
*.d
*.out

# Precompiled headers, debug info, linker leftovers.
*.gch
*.pch
*.pdb
*.ilk
*.dwo

# macOS bundles.
*.app

# CodeGraph index (local tooling, not project state).
.codegraph/
