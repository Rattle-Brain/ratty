{
  "keybindings": {
    "ctrl+shift+t": "new_tab",
    "ctrl+shift+w": "close_tab",
    "ctrl+tab": "next_tab",
    "ctrl+shift+tab": "prev_tab",
    "ctrl+1": "goto_tab_1",
    "ctrl+2": "goto_tab_2",
    "ctrl+3": "goto_tab_3",
    "ctrl+4": "goto_tab_4",
    "ctrl+5": "goto_tab_5",
    "ctrl+6": "goto_tab_6",
    "ctrl+7": "goto_tab_7",
    "ctrl+8": "goto_tab_8",
    "ctrl+9": "goto_tab_9",
    "ctrl+\\": "split_horizontal",
    "ctrl+-": "split_vertical",
    "ctrl+w": "close_split",
    "ctrl+shift+up": "focus_up",
    "ctrl+shift+down": "focus_down",
    "ctrl+shift+left": "focus_left",
    "ctrl+shift+right": "focus_right",
    "ctrl+shift+q": "quit",
    "f11": "fullscreen",
    "ctrl+shift+c": "copy",
    "ctrl+shift+v": "paste",
    "shift+pageup": "scroll_up",
    "shift+pagedown": "scroll_down",
    "ctrl+shift+k": "clear_scrollback"
  },
  "colors": {
    "background": "#1e1e1e",
    "foreground": "#d4d4d4"
  },
  "font": {
    "family": "Monospace",
    "size": 12
  },
  "window": {
    "width": 1280,
    "height": 720,
    "opacity": 1.0,
    "fullscreen": false
  }
}
